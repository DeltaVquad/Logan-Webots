#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Pavement.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Grass.proto"
EXTERNPROTO "../protos/Logan2026.proto"

WorldInfo {
  info [
    "Drone quadrirotor Logan."
    "Essa simulacao permite utilizar o drone Logan, quadricoptero desenvolvido pela equipe DeltaV da POLI-UPE."
  ]
  title "Logan Quadricoptero"
  basicTimeStep 2
  FPS 20
}
Viewpoint {
  orientation 0.22093058433558904 0.13931724224221503 -0.9652877202778243 2.0480034981866226
  position 0.5913042566841488 1.5274602985681434 0.884659573624852
  follow "Logan"
  followType "Mounted Shot"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  translation 0 0 0.001
  name "flightFloor"
  size 2.3 2.3
  appearance Pavement {
    type "black stone"
  }
}
Floor {
  name "roomFloor"
  size 20 20
  appearance Grass {
  }
}
Logan2026 {
  controller "ardupilot_vehicle_controller"
  controllerArgs [
    "--motors"
    "motor1, motor2, motor3, motor4"
    "--reversed-motors"
    "3,4"
    "--motor-cap"
    "100"
    "--camera"
    "camera"
    "--camera-fps"
    "10"
    "--camera-port"
    "8554"
  ]
}
