EXTERNPROTO "../protos/Logan2026_v6.proto"

WorldInfo {
  info [
    "Drone quadrirotor Logan."
    "Essa simulacao permite utilizar o drone Logan, quadricoptero desenvolvido pela equipe DeltaV da POLI-UPE."
  ]
  title "Logan Quadricoptero"
  basicTimeStep 2
  FPS 20
}
Viewpoint {
  orientation -0.0018143250387837164 0.9997962337114694 0.020104707931575472 0.18003648756658658
  position -13.470090774042312 0.1787954632969857 2.7228897476652767
  follow "Logan"
  followType "Mounted Shot"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  translation 0 0 0.001
  name "flightFloor"
  size 2.3 2.3
  appearance Pavement {
    type "black stone"
  }
}
Floor {
  name "roomFloor"
  size 20 20
  appearance Grass {
  }
}
Logan2026_v6 {
  controller "ardupilot_vehicle_controller"
  cameraPosition 0.0
  controllerArgs [
    "--motors"
    "motor1, motor2, motor3, motor4"
    "--reversed-motors"
    "3,4"
    "--servos"
    "camera_tilt"
    "--motor-cap"
    "100"
    "--camera"
    "camera"
    "--camera-fps"
    "10"
    "--camera-port"
    "8554"
  ]
}
